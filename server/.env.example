# Runtime
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database and authentication
MONGODB_URI=mongodb://127.0.0.1:27017/icl
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# AI chatbot is optional. With no key the chatbot answers from the database (Basic mode).
# Pick ONE provider here, or configure it later in Admin -> AI chatbot (admin settings override these).
# LLM_PROVIDER = groq | openai | gemini | xai | custom (auto-detected from whichever key is set)
LLM_PROVIDER=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# Generic key for LLM_PROVIDER=custom, plus optional overrides for any provider.
# Set LLM_BASE_URL to use any OpenAI-compatible service (OpenRouter, Ollama, Azure...).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
GROQ_MODEL=llama-3.3-70b-versatile

# CricHeroes is an optional cached public-page sync. Manual data always wins.
CRICHEROES_SYNC_ENABLED=false
CRICHEROES_SYNC_CRON=0 */6 * * *

# Public base URL of this API (used for uploaded image links behind a proxy)
PUBLIC_API_URL=
