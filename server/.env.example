# Runtime
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database and authentication
MONGODB_URI=mongodb://127.0.0.1:27017/icl
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Groq is optional. Leave blank to use the local regex chatbot fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CricHeroes is an optional cached public-page sync. Manual data always wins.
CRICHEROES_SYNC_ENABLED=false
CRICHEROES_SYNC_CRON=0 */6 * * *

# Optional: Redis adapter so Socket.io works across multiple API instances
REDIS_URL=
# Public base URL of this API (used for uploaded image links behind a proxy)
PUBLIC_API_URL=
